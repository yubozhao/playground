# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/stock_dashboard
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_REFRESH_SECRET=your-super-secret-refresh-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Server Configuration
PORT=3001
NODE_ENV=development

# Financial Data APIs
IEX_CLOUD_API_KEY=your-iex-cloud-api-key
IEX_CLOUD_BASE_URL=https://cloud.iexapis.com/stable
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-api-key
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query

# News API
NEWS_API_KEY=your-news-api-key
NEWS_API_BASE_URL=https://newsapi.org/v2

# Social Media APIs
TWITTER_BEARER_TOKEN=your-twitter-bearer-token
REDDIT_CLIENT_ID=your-reddit-client-id
REDDIT_CLIENT_SECRET=your-reddit-client-secret

# Email Service (for alerts)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=alerts@stocktracker.com

# Logging
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# WebSocket Configuration
WEBSOCKET_CORS_ORIGINS=http://localhost:5173,https://yourdomain.com

# Security
BCRYPT_ROUNDS=12
HELMET_CSP_ENABLED=true